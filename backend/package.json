{
  "name": "uit-connect-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API UIT Connect – chức năng SV ứng tuyển đề tài Lab (bài thực hành Web)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "seed:dn-files": "node --env-file=.env scripts/seed-dn-files.js",
    "test:sv-rd": "node --env-file=.env scripts/test-sv-rd-api.js",
    "test:auth": "node --env-file=.env scripts/test-auth-api.js",
    "test:public": "node --env-file=.env scripts/test-public-api.js",
    "test:team-join": "node --env-file=.env scripts/test-team-join-api.js",
    "test:team-profile": "node --env-file=.env scripts/test-team-profile-api.js",
    "test:team-invite": "node --env-file=.env scripts/test-team-invite-api.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "express": "^5.3.0",
    "playwright-core": "^1.65.1"
  }
}
