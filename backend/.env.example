# Chép file này thành .env rồi điền giá trị (Supabase → Project Settings → API Keys)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Xác thực: test = có phiên thì dùng phiên, gọi API không kèm phiên thì dùng tài khoản thử bên dưới
#           session = bắt buộc đăng nhập (không có phiên → 401)
AUTH_MODE=test
# Cookie phiên chỉ gửi qua HTTPS (true khi triển khai có HTTPS; chạy http://localhost thì để false)
COOKIE_SECURE=false

# Tài khoản SV thử (database/seed.sql), chỉ dùng khi AUTH_MODE=test và gọi API không kèm phiên
TEST_STUDENT_ID=9101
# Tài khoản DN thử (database/seed_dn.sql); bỏ trống thì mặc định 9501
TEST_BUSINESS_ID=9501
PORT=3000

# (Tùy chọn) Trình duyệt dùng để xuất CV ra PDF: msedge hoặc chrome. Bỏ trống thì tự thử cả hai.
# PDF_BROWSER_CHANNEL=msedge
